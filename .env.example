# Database Connection (Injected automatically by Vercel Supabase Integration)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Supabase Storage & Service API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Token Signing
JWT_SECRET=your_random_secure_jwt_secret_here

# (Optional) Google Gemini API Key for Automated Code Evaluation
GEMINI_API_KEY=your_gemini_api_key_here

# Initial Admin Credentials (Optional for automated local seeding)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_password_here
